{
	"name": "pi-provider-neon-ai-gateway",
	"version": "0.1.0",
	"description": "Neon AI Gateway model provider for the pi coding agent",
	"license": "GPL-3.0",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"neon",
		"neon-ai-gateway",
		"ai-gateway",
		"provider",
		"extension",
		"llm"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/randoneering/pi-provider-neon-ai-gateway.git"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"clean": "rm -rf dist .tsbuildinfo",
		"build": "tsc -p tsconfig.json --noEmit",
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"test:smoke": "tsx test/smoke.ts",
		"update-models": "tsx scripts/update-models.ts"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "0.85.1",
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@types/node": "^22.0.0",
		"tsx": "^4.19.0",
		"typescript": "^5.6.0",
		"vitest": "^2.1.0"
	}
}
